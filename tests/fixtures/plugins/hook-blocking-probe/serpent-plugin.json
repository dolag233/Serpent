{
  "manifestVersion": 1,
  "id": "com.serpent.hook-blocking-probe",
  "version": "1.0.0",
  "name": "Hook Blocking Probe",
  "description": "Fixed test plugin that blocks asset.trash through an onWill hook.",
  "author": "Serpent",
  "license": "MIT",
  "engines": {
    "serpent": ">=0.1.0 <1.0.0",
    "pluginApi": 1
  },
  "runtime": {
    "mode": "restricted",
    "entry": "entry/main.js"
  },
  "permissions": [
    "library.read",
    "asset.read",
    "storage.read",
    "storage.write",
    "hook.blocking"
  ],
  "contributes": {
    "commands": [],
    "menus": {},
    "views": [],
    "settings": [],
    "hooks": [
      {
        "id": "guard-trash",
        "event": "asset.trash",
        "blocking": true
      }
    ],
    "providers": []
  }
}
