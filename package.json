{
  "name": "serpent",
  "productName": "Serpent",
  "version": "0.1.0",
  "description": "An open-source digital asset manager for creative professionals.",
  "license": "MIT",
  "private": true,
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "verify:package": "node scripts/verify-package.mjs",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest-with-electron.mjs run",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:worker": "node scripts/run-vitest-with-electron.mjs run --config vitest.config.ts tests/worker",
    "test:e2e": "playwright test tests/e2e/library-lifecycle.test.ts tests/e2e/asset-ingestion.test.ts tests/e2e/process-lifecycle.test.ts tests/e2e/linked-folders.test.ts",
    "test:e2e:packaged": "playwright test tests/e2e/packaged-startup.test.ts",
    "test:watch": "node scripts/run-vitest-with-electron.mjs --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "12.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
