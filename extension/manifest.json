{
  "manifest_version": 3,
  "name": "Serpent",
  "version": "0.1.0",
  "description": "Save images and videos from the web to Serpent digital asset manager.",
  "permissions": ["contextMenus", "notifications", "storage"],
  "host_permissions": [
    "http://127.0.0.1:19876/*",
    "http://127.0.0.1:19877/*",
    "http://127.0.0.1:19878/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
