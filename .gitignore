.DS_Store
.agents/
.claude/
.kimi/
.daimon/
.worktrees/
.vscode/
skills-lock.json

node_modules/
**/.vite/
dist/
out/
coverage/
playwright-report/
test-results/
*.log
.env
.env.*
!.env.example

# Large platform media bundles are produced by the trusted build pipeline or
# acquired from a checksum-pinned release. Never commit local/system binaries.
resources/ffmpeg/
resources/oiio/
resources/media-binaries/*/manifest.json
resources/media-binaries/*/licenses/
resources/media-binaries/vcpkg/vcpkg_installed/
.media-build/
artifacts/media-binaries/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/issues.jsonl.lock
.beads/issues.jsonl.*.tmp
/skills

# 媒体产物目录（manifest 等为构建生成，来源/锁文件在 media-binaries/ 根）
resources/media-binaries/*/
!resources/media-binaries/vcpkg/
